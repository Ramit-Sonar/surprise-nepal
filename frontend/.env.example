# Public Google Maps browser key. Restrict it by HTTP referrer and enabled APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Cloud Map ID. Local builds use Google's demo map ID if blank.
VITE_GOOGLE_MAPS_MAP_ID=

# Base URL for the application backend API, for example https://api.example.com.
VITE_API_BASE_URL=

# Repository composition to use: "mock" for local demos or "api" for production.
VITE_REPOSITORY_MODE=mock
